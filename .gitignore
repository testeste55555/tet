# --------------------------------------------------
# OS-generated files
# --------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Thumbs.db:encryptable
Desktop.ini
$RECYCLE.BIN/

# --------------------------------------------------
# Editor / IDE settings
# --------------------------------------------------
.vscode/
.idea/
*.code-workspace
*.swp
*.swo
*~

# --------------------------------------------------
# Temporary / backup / log files
# --------------------------------------------------
*.tmp
*.temp
*.bak
*.backup
*.orig
*.rej
*.log
*.autosave

# --------------------------------------------------
# Local environment variables and secrets
# Keep sample files such as .env.example trackable.
# --------------------------------------------------
.env
.env.*
!.env.example
!.env.sample

# --------------------------------------------------
# JavaScript package managers and local caches
# The current site does not require these directories.
# --------------------------------------------------
node_modules/
.npm/
.pnpm-store/
.yarn/
.yarn-cache/
.cache/
.parcel-cache/
.vite/
coverage/

# --------------------------------------------------
# Python tooling, if used for local maintenance scripts
# --------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# --------------------------------------------------
# Local-only working directories
# --------------------------------------------------
tmp/
temp/
.local/

# --------------------------------------------------
# IMPORTANT: Do not ignore GitHub Pages source files.
# index.html, clock-calendar-learning/, assets, and
# .nojekyll must remain trackable and publishable.
# --------------------------------------------------

# --------------------------------------------------
# Additional credential / secret protection
# --------------------------------------------------
.env*
!.env.example
!.env.sample

# Private keys, certificates, PKCS stores, Java keystores
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.crt
*.cer
*.der
*.csr
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*

# CLI / package-manager credential stores
.npmrc
.netrc
.git-credentials

# Common credential / service-account / token files
credentials.json
credentials*.json
*credentials*.json
service-account*.json
*service-account*.json
service_account*.json
*service_account*.json
client_secret*.json
*client_secret*.json
secrets*.json
*secrets*.json
token*.json
*token*.json
*.secrets
*.token

# Local databases / dumps
*.db
*.db3
*.sqlite
*.sqlite3
*.mdb
*.accdb
*.dump
*.sql

# Additional backups / local state
*.old
*.save
*.pid
*.lock
*.stackdump
